# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Python Virtual Environments
venv/
env/
ENV/
env.bak/
venv.bak/

# Environment Variables & Local Secrets
.env
.env.*
!.env.example

# Cryptographic Keys (STRICTLY SERVER-SIDE ONLY - NEVER COMMIT)
*.pem
*.key
keys/*.pem
keys/*.key
!keys/.gitkeep

# Sensitive User Credential Storage (Auto-generated in production)
data/users.json

# Local Uploads & Test Artifacts
uploads/*
!uploads/.gitkeep

# macOS System Files
.DS_Store
.AppleDouble
.LSOverride

# IDEs & Text Editors
.idea/
.vscode/
*.swp
*.swo

# Test & Coverage Reports
.pytest_cache/
.coverage
htmlcov/
