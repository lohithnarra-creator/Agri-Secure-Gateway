# AGRI-SECURE GATEWAY: Production Environment Configuration Example
# Duplicate this file to .env for local testing (Do NOT commit .env to GitHub)

# Flask Session Security Key (Required in production)
FLASK_SECRET_KEY=super-secret-random-production-key-change-me

# Security Officer Admin Credentials (Overrides defaults in data/users.json)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Server Binding
PORT=5000
FLASK_DEBUG=False

# Optional: Persistent Cryptographic Keys (For Render Free Tier ephemeral disk persistence)
# RSA_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# RSA_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# AES_SECRET_KEY_HEX="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
